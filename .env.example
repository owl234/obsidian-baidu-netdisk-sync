# Obsidian Community Plugin Review Portal Configuration
# Get your token and cookies from https://community.obsidian.md/account
OBS_PLUGIN_URL=https://community.obsidian.md/account/plugins/baidu-netdisk-sync
OBS_TOKEN=your_obs_token_here
OBS_STRIPE_MID=your_stripe_mid_here
OBS_STRIPE_SID=your_stripe_sid_here

# Local Obsidian Isolated E2E Test Vault Configuration
# MUST point to a dedicated sandbox vault & isolated Baidu Netdisk folder
# (NEVER point to your production vault or /apps/obsidian_vault)
OBS_TEST_VAULT_NAME=obsidian-baidu-sync-test
OBS_TEST_VAULT_PATH=/Users/your_user/Documents/obsidian-baidu-sync-test
BAIDU_E2E_REMOTE_BASE=/apps/obsidian_vault_e2e_test

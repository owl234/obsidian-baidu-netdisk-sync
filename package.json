{
  "name": "obsidian-baidu-netdisk-sync",
  "version": "1.1.1",
  "description": "Free cross-platform multi-device sync with Baidu Netdisk (iOS/Android/Desktop). 免费多端/多设备百度网盘双向同步.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "npx esbuild tests/verify.ts --bundle --platform=node --outfile=dist/test.js && node dist/test.js",
    "check:review": "node scripts/verify-review.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "baidu-netdisk",
    "sync",
    "cloud",
    "e2ee",
    "cross-platform",
    "backup"
  ],
  "author": {
    "name": "OWL234",
    "url": "https://github.com/owl234"
  },
  "homepage": "https://github.com/owl234/obsidian-baidu-netdisk-sync#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/owl234/obsidian-baidu-netdisk-sync.git"
  },
  "bugs": {
    "url": "https://github.com/owl234/obsidian-baidu-netdisk-sync/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.1",
    "esbuild": "0.24.2",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.6.0",
    "obsidian": "latest",
    "tslib": "2.8.1",
    "typescript": "5.7.2",
    "typescript-eslint": "^8.73.0"
  }
}

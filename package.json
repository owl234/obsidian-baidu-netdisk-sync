    "check:review": "node scripts/verify-review.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "baidu-netdisk",
    "sync",
    "cloud"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.1",
    "esbuild": "0.24.2",
    "obsidian": "latest",
    "tslib": "2.8.1",
    "typescript": "5.7.2"
  }
}
